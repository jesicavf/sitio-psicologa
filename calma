<script>
// --- TABS CONTROLLER ---
const tabBtns = document.querySelectorAll('.tab-btn');
const panels = document.querySelectorAll('.panel');

tabBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    tabBtns.forEach(b => b.setAttribute('aria-selected', 'false'));
    panels.forEach(p => p.classList.remove('active'));
    
    btn.setAttribute('aria-selected', 'true');
    const targetId = btn.getAttribute('aria-controls');
    document.getElementById(targetId).classList.add('active');
  });
});

// --- WEB AUDIO API (GENTLE AUDIO CUES) ---
let audioCtx = null;
let soundEnabled = false;

function playCalmTone(freq, duration) {
  if (!soundEnabled) return;
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    
    osc.type = 'sine';
    osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
    
    gain.gain.setValueAtTime(0, audioCtx.currentTime);
    gain.gain.linearRampToValueAtTime(0.08, audioCtx.currentTime + 0.1);
    gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
    
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    
    osc.start();
    osc.stop(audioCtx.currentTime + duration);
  } catch (e) {}
}

document.getElementById('soundToggleBtn').addEventListener('click', function() {
  soundEnabled = !soundEnabled;
  this.textContent = `Sonido Guía: ${soundEnabled ? 'Activado' : 'Desactivado'}`;
  this.classList.toggle('alt', soundEnabled);
  if (soundEnabled) playCalmTone(440, 0.5);
});

// --- BREATHING ENGINE ---
let isBreathing = false;
let breathingTimeout = null;
let currentPatternKey = 'progressive';
let cycleCount = 0;

const respiratorCircle = document.getElementById('respiratorCircle');
const phaseText = document.getElementById('phaseText');
const timerText = document.getElementById('timerText');
const cycleIndicator = document.getElementById('cycleIndicator');
const startBtn = document.getElementById('startBreathingBtn');
const customControls = document.getElementById('customControls');

const predefinedPatterns = {
  progressive: { inhale: 4, hold: 4, exhale: 4, pause: 4, name: 'Progresiva (+1s por ciclo)' },
  box: { inhale: 4, hold: 4, exhale: 4, pause: 4, name: 'Cuadrada (4-4-4-4)' },
  478: { inhale: 4, hold: 7, exhale: 8, pause: 0, name: 'Calma Profunda (4-7-8)' },
  diaphragm: { inhale: 4, hold: 0, exhale: 6, pause: 0, name: 'Tranquilizadora (4-6)' }
};

document.querySelectorAll('.pattern-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.pattern-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentPatternKey = btn.dataset.pattern;
    customControls.style.display = currentPatternKey === 'custom' ? 'block' : 'none';
    if (isBreathing) stopBreathing();
  });
});

function getBreathingTimings() {
  if (currentPatternKey === 'custom') {
    return {
      inhale: Math.max(1, parseInt(document.getElementById('cfgInhale').value) || 4),
      hold: Math.max(0, parseInt(document.getElementById('cfgHold').value) || 0),
      exhale: Math.max(1, parseInt(document.getElementById('cfgExhale').value) || 4),
      pause: Math.max(0, parseInt(document.getElementById('cfgPause').value) || 0)
    };
  }
  
  const base = predefinedPatterns[currentPatternKey];
  if (currentPatternKey === 'progressive') {
    // Add cycleCount seconds to each active phase
    const bonus = cycleCount;
    return {
      inhale: base.inhale + bonus,
      hold: base.hold > 0 ? base.hold + bonus : 0,
      exhale: base.exhale + bonus,
      pause: base.pause > 0 ? base.pause + bonus : 0
    };
  }
  return base;
}

startBtn.addEventListener('click', () => {
  if (isBreathing) {
    stopBreathing();
  } else {
    startBreathing();
  }
});

function startBreathing() {
  isBreathing = true;
  cycleCount = 0;
  startBtn.textContent = 'Detener';
  startBtn.classList.add('alt');
  runBreathingCycle();
}

function stopBreathing() {
  isBreathing = false;
  clearTimeout(breathingTimeout);
  respiratorCircle.style.transition = 'transform 0.5s ease-out';
  respiratorCircle.style.transform = 'scale(1)';
  phaseText.textContent = 'Listo';
  timerText.textContent = '0';
  cycleIndicator.textContent = '';
  startBtn.textContent = 'Iniciar Respiración';
  startBtn.classList.remove('alt');
}

function runBreathingCycle() {
  if (!isBreathing) return;
  const timings = getBreathingTimings();
  
  if (currentPatternKey === 'progressive') {
    cycleIndicator.textContent = `Ciclo ${cycleCount + 1}: Fases de ${timings.inhale}s`;
  } else {
    cycleIndicator.textContent = predefinedPatterns[currentPatternKey] ? predefinedPatterns[currentPatternKey].name : 'Personalizado';
  }

  // 1. INHALE
  runPhase('Inhalá', timings.inhale, 1.4, 349.23, () => {
    // 2. HOLD
    if (timings.hold > 0) {
      runPhase('Sostené', timings.hold, 1.4, 440, () => {
        // 3. EXHALE
        runPhase('Exhalá', timings.exhale, 1.0, 261.63, () => {
          // 4. PAUSE
          if (timings.pause > 0) {
            runPhase('Pausa', timings.pause, 1.0, 220, () => {
              cycleCount++;
              runBreathingCycle();
            });
          } else {
            cycleCount++;
            runBreathingCycle();
          }
        });
      });
    } else {
      // EXHALE IMMEDIATELY
      runPhase('Exhalá', timings.exhale, 1.0, 261.63, () => {
        if (timings.pause > 0) {
          runPhase('Pausa', timings.pause, 1.0, 220, () => {
            cycleCount++;
            runBreathingCycle();
          });
        } else {
          cycleCount++;
          runBreathingCycle();
        }
      });
    }
  });
}

function runPhase(name, durationSec, targetScale, toneFreq, onComplete) {
  if (!isBreathing) return;
  phaseText.textContent = name;
  respiratorCircle.style.transition = `transform ${durationSec}s ease-in-out`;
  respiratorCircle.style.transform = `scale(${targetScale})`;
  playCalmTone(toneFreq, 0.4);

  let secondsLeft = durationSec;
  timerText.textContent = secondsLeft;

  const countdownInterval = setInterval(() => {
    secondsLeft--;
    if (secondsLeft > 0 && isBreathing) {
      timerText.textContent = secondsLeft;
    } else {
      clearInterval(countdownInterval);
    }
  }, 1000);

  breathingTimeout = setTimeout(() => {
    clearInterval(countdownInterval);
    if (isBreathing) onComplete();
  }, durationSec * 1000);
}

// --- GROUNDING WIZARD 5-4-3-2-1 ---
const groundingStepsData = [
  { count: 5, title: '5 Cosas que podés VER', prompt: 'Observá tu entorno y anotá o marcá 5 objetos específicos a tu alrededor (colores, sombras, texturas):', placeholder: 'Ej: Una planta, un marco de foto, la luz en la pared...' },
  { count: 4, title: '4 Cosas que podés TOCAR', prompt: 'Conectá con las sensaciones táctiles reales. Tocá o enfocate en 4 texturas presentes:', placeholder: 'Ej: La tela de mi pantalón, la mesa de madera fría...' },
  { count: 3, title: '3 Cosas que podés ESCUCHAR', prompt: 'Prestá atención sostenida a los sonidos ambientales más sutiles o distantes:', placeholder: 'Ej: El viento afuerta, el motor de la heladera, mi respiración...' },
  { count: 2, title: '2 Cosas que podés OLER', prompt: 'Inhalá suavemente y percibí 2 aromas u olores en tu espacio cercano:', placeholder: 'Ej: Perfume de jabón, aire fresco, café...' },
  { count: 1, title: '1 Cosa que podés SABOREAR', prompt: 'Registrá 1 sabor en tu boca en este instante o realizá 1 afirmación positiva de calma:', placeholder: 'Ej: Gusto a menta fresca o "Estoy a salvo en este instante"' }
];

let currentStepIdx = 0;
let userGroundingAnswers = Array(5).fill(null).map(() => []);

const stepCard = document.getElementById('stepCard');
const progressSteps = document.querySelectorAll('.progress-step');

function renderGroundingStep() {
  if (currentStepIdx >= groundingStepsData.length) {
    renderGroundingCompletion();
    return;
  }

  const data = groundingStepsData[currentStepIdx];
  
  // Update wizard step indicators
  progressSteps.forEach((st, idx) => {
    st.classList.remove('active', 'completed');
    if (idx < currentStepIdx) st.classList.add('completed');
    if (idx === currentStepIdx) st.classList.add('active');
  });

  let inputsHTML = '';
  for (let i = 0; i < data.count; i++) {
    const val = userGroundingAnswers[currentStepIdx][i] || '';
    inputsHTML += `
      <div class="grounding-input-group">
        <div class="checkbox-custom ${val.trim() !== '' ? 'checked' : ''}" onclick="toggleGCheck(this, ${i})"></div>
        <input type="text" class="g-input" placeholder="${data.placeholder}" value="${val}" oninput="updateGVal(${i}, this.value)">
      </div>
    `;
  }

  stepCard.innerHTML = `
    <div class="step-header">
      <div class="step-badge">${data.count}</div>
      <div>
        <h3 style="margin:0;">${data.title}</h3>
        <p style="margin:0; font-size:0.9rem; color:var(--muted);">${data.prompt}</p>
      </div>
    </div>
    <div class="grounding-inputs">${inputsHTML}</div>
    <div style="display:flex; justify-size:space-between; gap:12px; margin-top:24px; flex-wrap:wrap;">
      ${currentStepIdx > 0 ? `<button type="button" class="btn secondary" onclick="prevGStep()">Anterior</button>` : '<div></div>'}
      <button type="button" class="btn" onclick="nextGStep()">${currentStepIdx === 4 ? 'Finalizar Anclaje' : 'Siguiente Paso →'}</button>
    </div>
  `;
}

function updateGVal(idx, value) {
  userGroundingAnswers[currentStepIdx][idx] = value;
  const container = stepCard.querySelectorAll('.grounding-input-group')[idx];
  if (container) {
    const check = container.querySelector('.checkbox-custom');
    check.classList.toggle('checked', value.trim() !== '');
  }
}

function toggleGCheck(el, idx) {
  el.classList.toggle('checked');
  const input = el.nextElementSibling;
  if (el.classList.contains('checked') && !input.value) {
    input.value = 'Reconocido';
    userGroundingAnswers[currentStepIdx][idx] = 'Reconocido';
  }
}

function nextGStep() {
  currentStepIdx++;
  renderGroundingStep();
}

function prevGStep() {
  if (currentStepIdx > 0) {
    currentStepIdx--;
    renderGroundingStep();
  }
}

function renderGroundingCompletion() {
  progressSteps.forEach(st => st.classList.add('completed'));

  let summaryHTML = '<ul class="summary-list">';
  groundingStepsData.forEach((stData, sIdx) => {
    const items = userGroundingAnswers[sIdx].filter(x => x && x.trim() !== '');
    if (items.length > 0) {
      summaryHTML += `<li class="summary-item"><strong>${stData.title}:</strong> ${items.join(', ')}</li>`;
    }
  });
  summaryHTML += '</ul>';

  stepCard.innerHTML = `
    <div style="text-align:center; padding:10px 0;">
      <div style="width:56px; height:56px; border-radius:50%; background:var(--soft); color:var(--brand); display:inline-flex; align-items:center; justify-content:center; font-size:1.8rem; font-weight:700; margin-bottom:12px;">✓</div>
      <h3 style="margin-bottom:8px;">¡Excelente trabajo de anclaje!</h3>
      <p style="color:var(--muted); font-size:0.95rem;">Has reconectado con tu entorno sensorial. Tu cuerpo y tu mente vuelven al presente seguro.</p>
      ${summaryHTML}
      <button type="button" class="btn" style="margin-top:16px;" onclick="resetGrounding()">Reiniciar Ejercicio</button>
    </div>
  `;
}

function resetGrounding() {
  currentStepIdx = 0;
  userGroundingAnswers = Array(5).fill(null).map(() => []);
  renderGroundingStep();
}

renderGroundingStep();

